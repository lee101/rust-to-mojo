            writer.write("BottomLeft")
        elif self._tag == 3:
            writer.write("BottomRight")
        elif self._tag == 4:
            writer.write("TopCenter")
        elif self._tag == 5:
            writer.write("BottomCenter")
        elif self._tag == 6:
            writer.write("LeftCenter")
        elif self._tag == 7:
