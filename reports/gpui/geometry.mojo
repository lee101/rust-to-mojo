        """Returns the corner across from this corner, moving along the specified axis.

        # Examples

        (Rust code examples omitted by rust-to-mojo.)
        """
        if axis == Axis.Vertical:
            if self == Self.TopLeft:
                return Self.BottomLeft
            elif self == Self.TopRight:
                return Self.BottomRight
            elif self == Self.BottomLeft:
                return Self.TopLeft
            elif self == Self.BottomRight:
                return Self.TopRight
            elif self == Self.TopCenter:
                return Self.BottomCenter
            elif self == Self.BottomCenter:
                return Self.TopCenter
            elif self == Self.LeftCenter:
                return Self.LeftCenter
            else:
                return Self.RightCenter
        else:
            if self == Self.TopLeft:
                return Self.TopRight
            elif self == Self.TopRight:
                return Self.TopLeft
            elif self == Self.BottomLeft:
                return Self.BottomRight
            elif self == Self.BottomRight:
                return Self.BottomLeft
            elif self == Self.TopCenter:
                return Self.TopCenter
            elif self == Self.BottomCenter:
                return Self.BottomCenter
            elif self == Self.LeftCenter:
                return Self.RightCenter
            else:
                return Self.LeftCenter

    def is_center(self) -> Bool:
        """Returns whether the anchor is center-positioned."""
        return self == Self.TopCenter or self == Self.BottomCenter or self == Self.LeftCenter or self == Self.RightCenter

    def is_bottom(self) -> Bool:
        """Returns whether the anchor is bottom-positioned."""
        return self == Self.BottomCenter or self == Self.BottomLeft or self == Self.BottomRight

