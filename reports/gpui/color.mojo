    @staticmethod
    def from_(color: Rgba) -> Self:
        var r = color.r
        var g = color.g
        var b = color.b
        var max = fmax(r, fmax(g, b))
        var min = fmin(r, fmin(g, b))
        var delta = max - min
        var l = (max + min) / 2.0
        var s = 0.0 if l == 0.0 or l == 1.0 else delta / (2.0 * l) if l < 0.5 else delta / (2.0 - 2.0 * l)
