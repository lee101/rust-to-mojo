    """Transparent black in [`Hsla`]"""
    return Hsla(h=0.0, s=0.0, l=0.0, a=0.0)

def transparent_white() -> Hsla:
    """Transparent white in [`Hsla`]"""
    return Hsla(h=0.0, s=0.0, l=1.0, a=0.0)

def opaque_grey(lightness: Float32, opacity: Float32) -> Hsla:
    """Opaque grey in [`Hsla`], values will be clamped to the range [0, 1]"""
    return Hsla(h=0.0, s=0.0, l=clamp(lightness, 0.0, 1.0), a=clamp(opacity, 0.0, 1.0))

def white() -> Hsla:
    """Pure white in [`Hsla`]"""
    return Hsla(h=0.0, s=0.0, l=1.0, a=1.0)

def red() -> Hsla:
    """The color red in [`Hsla`]"""
    return Hsla(h=0.0, s=1.0, l=0.5, a=1.0)

def blue() -> Hsla:
    """The color blue in [`Hsla`]"""
    return Hsla(h=0.6666666667, s=1.0, l=0.5, a=1.0)

def green() -> Hsla:
    """The color green in [`Hsla`]"""
    return Hsla(h=0.3333333333, s=1.0, l=0.25, a=1.0)

def yellow() -> Hsla:
    """The color yellow in [`Hsla`]"""
    return Hsla(h=0.1666666667, s=1.0, l=0.5, a=1.0)

